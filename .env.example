# Copy this file to .env and fill in the values.

# PostgreSQL connection string. Works with Vercel Postgres, Neon, Supabase,
# or any hosted Postgres — use the same one for local dev and for Vercel.
DATABASE_URL="postgresql://user:password@host:5432/adagio?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# One-time database seeding via GET /api/admin/seed?secret=...
# Generate with: openssl rand -hex 16
SEED_SECRET=""

# PayPal (usa las credenciales de Sandbox mientras desarrollas)
# "sandbox" (pruebas) o "live" (pagos reales)
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
# ID del webhook de PayPal (Developer Dashboard → Webhooks), para validar
# que los eventos de renovación/cancelación vienen realmente de PayPal.
PAYPAL_WEBHOOK_ID=""
# IDs de los planes de facturación, generados una sola vez visitando
# /api/admin/paypal-setup?secret=TU_SEED_SECRET (ver README).
PAYPAL_PLAN_ID_MONTHLY=""
PAYPAL_PLAN_ID_ANNUAL=""

# Email para "olvidé mi contraseña" (https://resend.com, capa gratuita disponible)
RESEND_API_KEY=""
# Remitente de los correos. Sin verificar un dominio propio en Resend, usa
# el remitente de pruebas de Resend (envía igual, pero de forma limitada):
EMAIL_FROM="The Adagio Method <onboarding@resend.dev>"
