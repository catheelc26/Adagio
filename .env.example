# Copy this file to .env and fill in the values.

# PostgreSQL connection string. Works with Vercel Postgres, Neon, Supabase,
# or any hosted Postgres — use the same one for local dev and for Vercel.
DATABASE_URL="postgresql://user:password@host:5432/adagio?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# One-time database seeding via GET /api/admin/seed?secret=...
# Generate with: openssl rand -hex 16
SEED_SECRET=""

# Stripe (test mode keys during development)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_ANNUAL=""

# Email para "olvidé mi contraseña" (https://resend.com, capa gratuita disponible)
RESEND_API_KEY=""
# Remitente de los correos. Sin verificar un dominio propio en Resend, usa
# el remitente de pruebas de Resend (envía igual, pero de forma limitada):
EMAIL_FROM="The Adagio Method <onboarding@resend.dev>"
