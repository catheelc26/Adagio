# Credenciales del proyecto de Supabase (Project Settings → API).
# Copia este archivo a .env y rellena los valores reales. No se sube a git (ver .gitignore).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Clave pública VAPID para notificaciones push (ver README → "Notificaciones push").
# Es pública a propósito — la clave privada va solo como secreto de la función de Supabase.
VITE_VAPID_PUBLIC_KEY=
